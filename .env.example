# Pledge Fighter Environment Configuration

PROJECT_NAME=Pledge Fighter
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database (PostgreSQL for Docker/Production, SQLite default for local zero-dependency development)
DATABASE_URL=sqlite:///./pledge_fighter.db
# DATABASE_URL=postgresql://pledge_user:pledge_secure_password_2026@localhost:5432/pledge_fighter

# Background Processing
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage_uploads

# Minimum Threshold
MIN_SUBMISSION_THRESHOLD=5
